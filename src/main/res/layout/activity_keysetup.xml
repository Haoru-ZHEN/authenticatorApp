<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".KeySetupActivity"
    android:background="@color/white">

    <androidx.cardview.widget.CardView
        android:id="@+id/connectingBox_keysetup"
        android:layout_width="450px"
        android:layout_height="450px"
        app:cardCornerRadius="15dp"
        app:cardElevation="10dp"
        android:background="#000"
        android:layout_centerInParent="true">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="20dp">
            <TextView
                android:id="@+id/connectingText_keysetup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Connecting..."
                android:textSize="18dp"
                android:textStyle="bold"
                android:textAlignment="center"
                android:textColor="@color/blue">

            </TextView>
            <ImageView
                android:id="@+id/doneIcon_keysetup"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:clickable="true"
                android:layout_centerInParent="true"
                app:srcCompat="@drawable/baseline_check_24"/>

            <ProgressBar
                android:id="@+id/progressBar_keysetup"
                style="?android:attr/progressBarStyle"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true"
                android:indeterminateTint="@color/blue"/>
        </RelativeLayout>
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <ImageView
                android:id="@+id/backIcon_keysetup"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:background="@drawable/ripple_white"
                android:clickable="true"
                app:srcCompat="@drawable/ic_baseline_arrow_back_24" />

            <TextView
                android:id="@+id/titleText_dashboard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:fontFamily="@font/roboto"
                android:text="Enter a setup key"
                android:textAlignment="textStart"
                android:textColor="@color/black2"
                android:textSize="20dp"
                android:textStyle="bold" />

        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/infoLayout_keysetup"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp"
                app:boxStrokeColor="@color/blue"
                app:startIconDrawable="@drawable/baseline_person_24"
                app:startIconTint="@color/blue">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/infoInput_keysetup"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/roboto"
                    android:hint="User Info"
                    android:inputType="text"
                    android:textSize="16sp" />


            </com.google.android.material.textfield.TextInputLayout>


            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/keycodeLayout_keysetup"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp"
                app:boxStrokeColor="@color/blue"
                app:startIconDrawable="@drawable/key_24px"
                app:startIconTint="@color/blue">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/keycodeInput_keysetup"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/roboto"
                    android:hint="Provided Key"
                    android:inputType="text"
                    android:textSize="16sp" />


            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="OTP Type"
                android:layout_marginBottom="15dp">

                <AutoCompleteTextView
                    android:id="@+id/autoTextview_keysetup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="SHA Algorithm"
                android:layout_marginBottom="15dp">

                <AutoCompleteTextView
                    android:id="@+id/shaTextview_keysetup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>
            <Button
                android:id="@+id/connectBut_keysetup"
                android:layout_width="150dp"
                android:layout_height="60dp"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true"
                android:layout_marginTop="20dp"
                android:backgroundTint="@color/blue"
                android:enabled="true"
                android:fontFamily="@font/roboto"
                android:text="Connect"
                android:textAllCaps="false"
                android:textSize="20sp"
                android:textStyle="bold"
                app:cornerRadius="10dp" />


        </LinearLayout>


    </LinearLayout>
</RelativeLayout>