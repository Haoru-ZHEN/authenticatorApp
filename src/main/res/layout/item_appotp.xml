<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:backgroundTint="@color/aliceblue"
        app:cardCornerRadius="15dp"
        app:cardElevation="5dp">


        <RelativeLayout
            android:id="@+id/layout_appotp_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/ripple_rect"
            android:paddingLeft="10dp"
            android:paddingTop="5dp"
            android:paddingRight="10dp"
            android:paddingBottom="0dp">

            <ImageView
                android:id="@+id/imgApp_appotp_item"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_centerVertical="true"
                android:layout_marginRight="10dp"
                android:src="@drawable/falcon" />


            <TextView
                android:id="@+id/appname_appotp_item"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@id/imgApp_appotp_item"
                android:fontFamily="@font/roboto"
                android:text="Facebook"
                android:textColor="@color/black3"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/info_appotp_item"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/appname_appotp_item"
                android:layout_marginTop="0dp"
                android:layout_toRightOf="@id/imgApp_appotp_item"
                android:fontFamily="@font/roboto_light"
                android:text="zhenhaochok@gmail.com"
                android:textColor="@color/black7"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/code_appotp_item"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/info_appotp_item"
                android:layout_marginTop="0dp"
                android:layout_toRightOf="@id/imgApp_appotp_item"
                android:fontFamily="@font/roboto"
                android:text="108 458"
                android:textColor="@color/black3"
                android:textSize="25sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/progressBar_appotp_item"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/code_appotp_item"
                android:layout_toRightOf="@id/imgApp_appotp_item"
                android:indeterminate="false"
                android:max="100"
                android:progress="100"
                android:progressTint="@color/blue"
                android:rotation="0" />

            <View
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_below="@id/code_appotp_item"
                android:layout_marginTop="10dp"
                android:layout_toRightOf="@id/imgApp_appotp_item"
                android:background="@color/blue"
                android:visibility="gone" />


            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:padding="5dp">

                <ImageView
                    android:id="@+id/fingerIcon_friend_item"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_centerVertical="true"
                    android:background="@drawable/ripple_white"
                    app:srcCompat="@drawable/ic_baseline_fingerprint_24" />
            </RelativeLayout>

        </RelativeLayout>
    </androidx.cardview.widget.CardView>
</RelativeLayout>